# Backend/.env for LOCAL development — generated by `npm run setup` from scripts/env/backend.env.
# Values match the services in the root docker-compose.yml. Gitignored; safe to edit.

FLASK_ENV=development
# 5000 is taken by macOS AirPlay Receiver, so Flask runs on 5050 locally
PORT=5050
# Keep the Flask debugger off the network
HOST=127.0.0.1
SECRET_KEY=__SECRET_KEY__
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (docker compose)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=learnbot
DB_USER=learnbot
DB_PASSWORD=learnbot_local

# Gmail SMTP for OTP / password-reset emails. Blank = OTPs are printed to the Flask console.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# LLMs — chat needs at least one reachable model.
# Claude: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=__ANTHROPIC_API_KEY__
CLAUDE_MODEL_ID=claude-haiku-4-5-20251001
# Blackwell / Gemma lab server — only reachable on the Northeastern network or VPN
REMOTE_BLACKWELL_URL=http://129.10.224.226:8000/v1/chat/completions
REMOTE_BLACKWELL_MODEL=google/gemma-3-12b-it

# Qdrant (docker compose). Keep QDRANT_API_KEY unset for local Qdrant.
QDRANT_URL=http://localhost:6333

# RAG feature flags
ENABLE_RERANKING=false
ENABLE_LLM_GUARDS=false
ENABLE_LLM_ANALYTICS=true
ENABLE_LLM_PII_STRIPPING=true

# Queue mode: Flask publishes chat tasks to RabbitMQ, worker.py dispatches them back to Flask,
# tokens stream through Redis. If RabbitMQ/Redis are down, Flask answers synchronously instead.
NAMESPACE=local
RABBITMQ_URL=amqp://learnbot:learnbot123@localhost:5672
REDIS_URL=redis://localhost:6379
FLASK_INTERNAL_URL=http://127.0.0.1:5050

# --- Local models (offline) ---
# Served by Ollama's OpenAI-compatible API, reached over an SSH tunnel:
#   ssh -N -L 21434:127.0.0.1:11434 <user>@<gb10-host>
LOCAL_LLM_URL=http://localhost:21434/api/chat
LOCAL_NEMOTRON_MODEL=nemotron-3.5-lightning:30b
LOCAL_QWEN_MODEL=qwen3.6:35b-a3b
LOCAL_NANO_MODEL=nemotron-3-nano:4b
DEFAULT_LOCAL_BACKEND=local-nemotron
# Both are reasoning models: the thinking pass consumes tokens before the answer,
# so keep this generous or replies come back empty.
LOCAL_MAX_TOKENS=4000

# --- Voice service (STT + TTS, FastAPI) ---
# Tunnelled alongside the models; see the tunnel command in the README.
VOICE_API_URL=http://localhost:8100
NEXT_PUBLIC_VOICE_API_URL=http://localhost:8100
VOICE_STT_ENGINE=parakeet
VOICE_TTS_ENGINE=kokoro
VOICE_TTS_VOICE=af_sarah
EMBED_MODEL=nemotron-embed-1b-v2
