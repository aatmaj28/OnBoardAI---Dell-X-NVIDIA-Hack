# Frontend/.env.local for LOCAL development — generated by `npm run setup` from scripts/env/frontend.env.local.
# Values match Backend/.env and the root docker-compose.yml. Gitignored; safe to edit.

# Flask backend (browser + Next.js API routes call this)
NEXT_PUBLIC_FLASK_API_URL=http://localhost:5050
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (docker compose) — some Next.js API routes query the DB directly
DB_HOST=localhost
DB_PORT=5433
DB_NAME=learnbot
DB_USER=learnbot
DB_PASSWORD=learnbot_local

# Next.js's RAG service (lib/rag-service.ts) runs Python from the Backend virtualenv
PYTHON_PATH=__REPO_ROOT__/Backend/.venv/bin/python

QDRANT_URL=http://localhost:6333

# Gmail SMTP (optional, same as Backend/.env)
GMAIL_USER=
GMAIL_APP_PASSWORD=

ANTHROPIC_API_KEY=__ANTHROPIC_API_KEY__
CLAUDE_MODEL_ID=claude-haiku-4-5-20251001
REMOTE_BLACKWELL_URL=http://129.10.224.226:8000/v1/chat/completions
REMOTE_BLACKWELL_MODEL=google/gemma-3-12b-it

ENABLE_RERANKING=false
ENABLE_LLM_GUARDS=false
ENABLE_LLM_ANALYTICS=true
STREAM_CHUNK_DELAY=0.05
