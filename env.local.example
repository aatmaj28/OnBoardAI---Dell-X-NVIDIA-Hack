# Gmail Configuration for Email Verification
# Follow these steps to get your credentials:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an app password for "Mail"
# 5. Copy the 16-character password and paste below

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# DATABASE CONFIGURATION
# Option 1: University Local Server (via SSH port forwarding)
# Step 1: Set up SSH port forwarding (run this in a separate terminal and keep it open):
#   ssh -L 5433:localhost:5432 ra_aatmaj@129.10.224.226
#   Note: Using local port 5433 to avoid conflicts with local PostgreSQL
# Step 2: Use these settings:
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=dashbox@26

# Option 2: Supabase (Cloud Database - Comment out the above and use this instead)
# DB_HOST=db.scjlcrxzrylhrtzeiwql.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_SUPABASE_PASSWORD_HERE

# Claude (Anthropic) Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Remote A6000 (Ollama) Configuration (Labs Server)
# Set up SSH tunnel: ssh -L 5001:localhost:11434 ra_aatmaj@129.10.224.226
REMOTE_OLLAMA_URL=http://localhost:5001/api/generate
REMOTE_OLLAMA_MODEL=gemma3:27b

# Remote Blackwell (vLLM) Configuration (Labs Server) - 2x faster than A6000
# Direct connection (no tunnel needed if server is accessible)
# Or use SSH tunnel: ssh -L 8001:localhost:8000 ra_aatmaj@129.10.224.226
# Then set: REMOTE_BLACKWELL_URL=http://localhost:8001/v1/chat/completions
REMOTE_BLACKWELL_URL=http://129.10.224.226:8000/v1/chat/completions
REMOTE_BLACKWELL_MODEL=google/gemma-3-12b-it

# RAG Configuration
# Enable/disable reranking (ML-based chunk reranking for better quality)
# Set to 'true' for better quality (but ~17s slower)
# Set to 'false' for faster responses (FAISS scores only)
ENABLE_RERANKING=false

# Enable/disable LLM-based guards (Input Guard & Leak Detection)
# Set to 'true' to use llama3.1:8b for intelligent analysis (~2-4s per guard)
# Set to 'false' for simplified guards (keyword matching, ~0s)
# RECOMMENDED: false (team lead advice - "pure latency tax before you even search")
ENABLE_LLM_GUARDS=false

# Analytics mode: true = LLM-based (Blackwell, slower but more accurate), false = Enhanced keyword-based (n-grams, faster)
# This controls both background analytics worker and Student Monitoring tab
ENABLE_LLM_ANALYTICS=true

# Qdrant Vector Store Configuration
# Server mode (default): Connect to Qdrant server at http://localhost:6333
# Set QDRANT_URL="" to use local persistent storage instead
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional: API key for cloud Qdrant (leave empty for local)

# Streaming Configuration
# Delay between chunks in seconds (0 = instant, 0.05 = smooth typing effect)
# Increase this value to slow down the streaming for a more visible "typing" effect
# Examples: 0 (instant), 0.05 (fast typing), 0.1 (medium), 0.2 (slow)
STREAM_CHUNK_DELAY=0.05

# Flask API Configuration
# URL of your Flask backend API
# Development: http://localhost:5000
# Production: http://your-flask-server:5000
NEXT_PUBLIC_FLASK_API_URL=http://localhost:5000
