# ============================================
# EssayBot Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# For development, you can also create .env.local to override values

# ============================================
# Environment
# ============================================
NODE_ENV=development
ENVIRONMENT=development
NAMESPACE=uat

# ============================================
# Server Configuration
# ============================================
# Express/Node.js Server
PORT=8002
INSTANCES=4

# Flask/Python Server
FLASK_PORT=6001
FLASK_ENV=production
FLASK_DEBUG=false

# Python Service URL (used by workers)
PYTHON_SERVICE_URL=http://localhost:6001

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# For local: mongodb://localhost:27017/essaybot
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://essaybot:essaybot123@localhost:27017/essaybot
MONGODB_URI=mongodb://essaybot:essaybot123@localhost:27017/essaybot

# Alternative format
DATABASE_URL=mongodb://essaybot:essaybot123@localhost:27017/essaybot

# ============================================
# Message Queue & Cache
# ============================================
# RabbitMQ
RABBITMQ_URL=amqp://essaybot:essaybot123@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# ============================================
# S3/MinIO Storage
# ============================================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here
MINIO_BUCKET=essaybot
S3_REGION=us-east-1

# ============================================
# LLM/AI Configuration
# ============================================
# Ollama or vLLM endpoint
OLLAMA_URL=http://localhost:7000/v1/completions
OLLAMA_MODEL_URL=http://localhost:8000

# ============================================
# Qdrant Vector Store Configuration
# ============================================
# Qdrant connection settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=essay_bot_materials
QDRANT_API_KEY=
QDRANT_USE_GRPC=false

# ============================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================
# Note: The new system uses SemanticSplitterNodeParser which intelligently
# splits documents based on semantic meaning rather than fixed chunk sizes

# Embedding Model Configuration
EMBEDDING_MODEL=BAAI/bge-large-en
EMBEDDING_BATCH_SIZE=32
MAX_TOKEN_LENGTH=512

# Retrieval Settings
SIMILARITY_TOP_K=10
DISTANCE_THRESHOLD=0.5
MAX_TOTAL_LENGTH=4000

# ============================================
# GPU Configuration
# ============================================
# Enable GPU acceleration for embeddings
USE_GPU=true

# Specify GPU device (0, 1, 2, etc.) - use GPU 1 by default
GPU_DEVICE_ID=1

# Alternative: Specify GPU by UUID (leave empty to use device ID)
GPU_DEVICE_UUID=

# Enable automatic GPU memory cleanup
ENABLE_GPU_CLEANUP=true

# ============================================
# Authentication & Security
# ============================================
# JWT Secret for token signing
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ============================================
# Frontend URLs (CORS Configuration)
# ============================================
# Development URLs
DASH_PORTAL_CLIENT_URL=http://localhost:3000
ESSAYBOT_CLIENT_URL=http://localhost:3003

# Production URLs
DASH_PORTAL_PRODUCTION_URL=https://dashlab.studio
ESSAYBOT_PRODUCTION_URL=https://essaybot.dashlab.studio

# Frontend URL for WebSocket CORS
FRONTEND_URL=http://localhost:3000

# ============================================
# Monitoring & Alerts
# ============================================
# Microsoft Teams webhook for production alerts
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url-here

# ============================================
# LangGraph Configuration (Optional)
# ============================================
# LangSmith tracing (if using LangSmith for observability)
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=essaybot-grading
# LANGCHAIN_TRACING_V2=true

# ============================================
# Development Tools (Optional)
# ============================================
# Log levels
LOG_LEVEL=info

# Enable debug logging
DEBUG=false
