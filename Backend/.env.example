# LearnBOT Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Flask server
# ---------------------------------------------------------------------------
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-me-to-a-random-string
# Comma-separated list of origins the frontend may hit. For local: localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (local Docker Postgres on host port 5433)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=dashbox@26

# ---------------------------------------------------------------------------
# Gmail SMTP (OTP / password reset emails)
# Generate a Google App Password: https://myaccount.google.com/apppasswords
# Leave blank to skip email delivery (OTPs will still log to console for dev).
# ---------------------------------------------------------------------------
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Anthropic (Claude) — works anywhere the internet works
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL_ID=claude-haiku-4-5-20251001

# Blackwell / Gemma — Northeastern lab server. Only reachable on campus or VPN.
# Safe to leave set; unreachable requests fail silently and chat falls back to Claude.
REMOTE_BLACKWELL_URL=http://129.10.224.226:8000/v1/chat/completions
REMOTE_BLACKWELL_MODEL=google/gemma-3-12b-it

# ---------------------------------------------------------------------------
# Qdrant vector store (local docker run, default port)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY only needed for Qdrant Cloud. LEAVE COMMENTED for local / self-hosted.
# Setting it to empty string makes qdrant-client auto-upgrade to HTTPS and break local Qdrant.
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ---------------------------------------------------------------------------
# RAG feature flags
# ---------------------------------------------------------------------------
ENABLE_RERANKING=false
ENABLE_LLM_GUARDS=false
ENABLE_LLM_ANALYTICS=true
ENABLE_LLM_PII_STRIPPING=true

# ---------------------------------------------------------------------------
# RabbitMQ + Redis (local docker run, default ports)
# ---------------------------------------------------------------------------
RABBITMQ_URL=amqp://learnbot:learnbot123@localhost:5672
REDIS_URL=redis://localhost:6379

# Worker → Flask dispatch URL. worker.py defaults to :8030 (UAT internal port);
# local Flask runs on :5000, so override here.
FLASK_INTERNAL_URL=http://localhost:5000

# --- Local models (offline) ---
# Served by Ollama's OpenAI-compatible API, reached over an SSH tunnel:
#   ssh -N -L 21434:127.0.0.1:11434 <user>@<gb10-host>
LOCAL_LLM_URL=http://localhost:21434/api/chat
LOCAL_NEMOTRON_MODEL=nemotron-3.5-lightning:30b
LOCAL_QWEN_MODEL=qwen3.6:35b-a3b
LOCAL_NANO_MODEL=nemotron-3-nano:4b
DEFAULT_LOCAL_BACKEND=local-nemotron
# Both are reasoning models: the thinking pass consumes tokens before the answer,
# so keep this generous or replies come back empty.
LOCAL_MAX_TOKENS=4000

# --- Voice service (STT + TTS, FastAPI) ---
# Tunnelled alongside the models; see the tunnel command in the README.
VOICE_API_URL=http://localhost:8100
NEXT_PUBLIC_VOICE_API_URL=http://localhost:8100
VOICE_STT_ENGINE=parakeet
VOICE_TTS_ENGINE=kokoro
VOICE_TTS_VOICE=af_sarah
EMBED_MODEL=nemotron-embed-1b-v2
